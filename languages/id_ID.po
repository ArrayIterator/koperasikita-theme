msgid "No scraping source is enabled. Enable one on the Setting tab."
msgstr "Tidak ada sumber scraping yang diaktifkan. Aktifkan satu sumber pada tab Pengaturan."

msgid "Price chart"
msgstr "Grafik harga"

msgid "Save gold brands"
msgstr "Simpan merek emas"

